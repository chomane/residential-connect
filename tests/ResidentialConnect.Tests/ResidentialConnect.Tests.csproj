<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- WinDivertSystemTrafficRouterTests intentionally exercises the
         Windows-only router from this cross-platform test project (guarded
         at runtime via OperatingSystem.IsWindows()) so the fail-closed /
         IsSupported=false behavior is verified even on non-Windows CI. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResidentialConnect.Core\ResidentialConnect.Core.csproj" />
    <ProjectReference Include="..\..\src\ResidentialConnect.Security\ResidentialConnect.Security.csproj" />
    <ProjectReference Include="..\..\src\ResidentialConnect.Proxy\ResidentialConnect.Proxy.csproj" />
    <ProjectReference Include="..\..\src\ResidentialConnect.Browser\ResidentialConnect.Browser.csproj" />
    <ProjectReference Include="..\..\src\ResidentialConnect.Routing\ResidentialConnect.Routing.csproj" />
  </ItemGroup>

</Project>