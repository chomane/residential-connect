<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ResidentialConnect.Core\ResidentialConnect.Core.csproj" />
    <ProjectReference Include="..\ResidentialConnect.Security\ResidentialConnect.Security.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Lets ResidentialConnect.Tests use ProxiedDohResolver's internal
      test-only constructor overload (dohEndpointOverride) so
      ProxiedDohResolverTests can point the resolver at a local fake DoH
      server instead of the real cloudflare-dns.com endpoint, without a
      real network call.
    -->
    <InternalsVisibleTo Include="ResidentialConnect.Tests" />
  </ItemGroup>

</Project>
