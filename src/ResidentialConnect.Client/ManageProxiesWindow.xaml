<Window x:Class="ResidentialConnect.Client.ManageProxiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Proxies" Height="480" Width="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ProxyGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="ProxyGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                <DataGridTextColumn Header="Country" Binding="{Binding CountryName}" Width="110"/>
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="110"/>
                <DataGridTextColumn Header="Last Test" Binding="{Binding LastTestResult.Message}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add Proxy" Padding="10,4" Margin="0,0,6,0" Click="AddProxy_Click"/>
            <Button Content="Edit" Padding="10,4" Margin="0,0,6,0" Click="EditProxy_Click"/>
            <Button Content="Delete" Padding="10,4" Margin="0,0,6,0" Click="DeleteProxy_Click"/>
            <Button Content="Test" Padding="10,4" Margin="0,0,6,0" Click="TestProxy_Click"/>
            <Button Content="Select" Padding="10,4" Margin="0,0,6,0" Click="SelectProxy_Click"/>
            <Button Content="Import CSV..." Padding="10,4" Margin="0,0,6,0" Click="ImportCsv_Click"/>
            <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
