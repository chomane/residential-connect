<Window x:Class="ResidentialConnect.Client.AddEditProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add / Edit Proxy" Height="420" Width="380" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,8"/>
        <TextBlock Text="Host / IP"/>
        <TextBox x:Name="HostBox" Margin="0,0,0,8"/>
        <TextBlock Text="Port"/>
        <TextBox x:Name="PortBox" Margin="0,0,0,8"/>
        <TextBlock Text="Username"/>
        <TextBox x:Name="UsernameBox" Margin="0,0,0,8"/>
        <TextBlock Text="Password"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8"/>
        <TextBlock Text="Protocol"/>
        <ComboBox x:Name="ProtocolBox" Margin="0,0,0,8">
            <ComboBoxItem Content="Http" IsSelected="True"/>
            <ComboBoxItem Content="Socks5"/>
        </ComboBox>
        <TextBlock Text="Country Code (e.g. US)"/>
        <TextBox x:Name="CountryCodeBox" Margin="0,0,0,8"/>
        <TextBlock Text="City"/>
        <TextBox x:Name="CityBox" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="10,4" Margin="0,0,6,0" Click="Cancel_Click"/>
            <Button Content="Save" Padding="10,4" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
